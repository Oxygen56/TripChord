# Production authentication is opt-in locally and mandatory in the deployment profile.
# The value is JSON mapping opaque bearer tokens to tenant identifiers.
TRIPCHORD_AUTH_TOKENS={"replace-with-a-random-secret":"demo-tenant"}

# Optional production travel suppliers. Never commit real credentials.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_ENVIRONMENT=sandbox
AMAP_API_KEY=

# Real model Agents are opt-in. The safe checked-in default performs no paid
# model calls. To reproduce the standalone DeepSeek smoke, change provider to
# openai_compatible, fill the endpoint/model/key, and set required=true.
# `MODEL_AGENTS_REQUIRED=true` makes a missing/failed model stage block instead
# of being reported as an auditable deterministic fallback.
MODEL_PROVIDER=none
MODEL_API_KEY=
MODEL_NAME=
MODEL_FAST_NAME=
MODEL_BASE_URL=
MODEL_AGENTS_REQUIRED=false
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_ATTEMPTS=3
# auto selects json_object for DeepSeek and json_schema for compatible gateways.
MODEL_RESPONSE_FORMAT_MODE=auto
# auto explicitly disables DeepSeek V4's default thinking mode for the safest
# tool-loop contract. Set enabled only when reasoning_content replay is required.
MODEL_THINKING_MODE=auto
# 确定性预算控制器按日期、候选、证据缺口、修复与事件状态创建白名单临时 Agent；
# 只扩模型推理，不提高 Chrome/OTA 并发，也不放宽真实报价和 Verifier 门。
ADAPTIVE_AGENT_SCALING_ENABLED=true
# 所有并行 Agent 复用一个有界连接池；HTTP/2 默认关闭，避免额外运行时依赖。
MODEL_HTTP2_ENABLED=false
MODEL_HTTP_MAX_CONNECTIONS=12
MODEL_HTTP_MAX_KEEPALIVE_CONNECTIONS=12
MODEL_HTTP_MAX_IN_FLIGHT=12

# Scoped Agent memory. This local adapter survives API restarts with atomic,
# checksummed JSON snapshots; it is single-process and not encrypted at rest.
MEMORY_STATE_PATH=.runtime/agent-memory.json
MEMORY_CORRUPTION_POLICY=fail_closed
MEMORY_PERSIST_SENSITIVE=false

# Event-replanning run state. Empty STATE_PATH disables persistence. This
# checksummed local snapshot supports exactly one API worker; it is not a
# multi-worker coordination backend.
TRIPCHORD_LIVE_RUN_CACHE_STATE_PATH=.runtime/live-run-cache.json
TRIPCHORD_LIVE_RUN_CACHE_CORRUPTION_POLICY=fail_closed

# Optional local Chrome bridge. The companion and OTA login/permissions are
# still required in addition to the model key.
TRIPCHORD_BROWSER_BRIDGE_ENABLED=false
TRIPCHORD_BROWSER_BRIDGE_TOKEN=
# 显式启用内部后台监督器；不需要也不会向扩展暴露外部控制令牌。
TRIPCHORD_BROWSER_COMPANION_AUTO_RELOAD_ENABLED=false
# 仅保护可选的本机 HTTP 控制端点；必须与 bridge token 不同。
TRIPCHORD_BROWSER_BRIDGE_CONTROL_TOKEN=
TRIPCHORD_BROWSER_BRIDGE_STATE_PATH=.runtime/browser-bridge-state.json
# 默认仅允许 Chrome 扩展 origin 与本机 Web UI；只有自定义扩展方案才需要覆盖。
TRIPCHORD_BROWSER_BRIDGE_ALLOWED_ORIGIN_REGEX=^(chrome-extension://[a-p]{32}|http://(?:127\.0\.0\.1|localhost)(?::\d+)?)$
